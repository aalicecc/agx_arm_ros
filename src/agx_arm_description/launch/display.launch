<launch>
  <!--
    arm_type resolution order:
      1. Predefined type name (piper, piper_x, piper_l, piper_h, nero) -> mapped URDF path
      2. Relative path under agx_arm_urdf/ (if file exists)
      3. Absolute path (used directly)
  -->
  <arg name="arm_type" default="piper"/>
  <!-- Flag to enable joint_state_publisher_gui instead of joint_state_publisher -->
  <arg name="gui" default="true"/>
  <!-- Absolute path to rviz config file -->
  <arg name="rvizconfig" default="$(find agx_arm_description)/rviz/display.rviz"/>

  <arg name="model_path" default="$(eval
    find('agx_arm_description') + '/agx_arm_urdf/' +
    {'piper':   'piper/urdf/piper_description.urdf',
     'piper_x': 'piper_x/urdf/piper_x_description.urdf',
     'piper_l': 'piper_l/urdf/piper_l_description.urdf',
     'piper_h': 'piper_h/urdf/piper_h_description.urdf',
     'nero':    'nero/urdf/nero_description.urdf'}[arg('arm_type')]
    if arg('arm_type') in ('piper','piper_x','piper_l','piper_h','nero')
    else (arg('arm_type')
          if arg('arm_type').startswith('/')
          else find('agx_arm_description') + '/agx_arm_urdf/' + arg('arm_type'))
  )"/>

  <!-- Load robot description from URDF via xacro -->
  <param name="robot_description" command="xacro $(arg model_path)"/>

  <!-- Publish joint states without GUI -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"
        unless="$(arg gui)"/>

  <!-- Publish joint states with GUI sliders -->
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui"
        if="$(arg gui)"/>

  <!-- Publish robot state (TF transforms) from URDF and joint states -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- Launch RViz with the specified config -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rvizconfig)" output="screen"/>
</launch>
